generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth / Auth.js v5) ───────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  phone          String?
  designation    String?
  organization   String?
  role           Role      @default(STUDENT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  enrollments           Enrollment[]
  assignmentSubmissions AssignmentSubmission[]
  courseAssignments     CourseInstructor[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Courses ─────────────────────────────────────────────────────────────────

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  subtitle      String?
  description   String
  thumbnail     String?
  status        CourseStatus @default(UPCOMING)
  price         Int
  originalPrice Int?
  durationLabel String
  classCount    Int
  classHours    Int
  batchSize     String
  level         String
  category      String
  whatsappLink  String?
  meetLink      String?
  isPublished   Boolean      @default(false)
  isFeatured    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  modules               CourseModule[]
  enrollments           Enrollment[]
  classSchedules        ClassSchedule[]
  assignments           Assignment[]
  instructorAssignments CourseInstructor[]
}

model CourseModule {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  order       Int
  isCompleted Boolean @default(false)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([courseId, order])
}

/**
 * Links an INSTRUCTOR user to the course(s) they teach.
 */
model CourseInstructor {
  id       String @id @default(cuid())
  courseId String
  userId   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model ClassSchedule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  meetLink  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, startsAt])
}

model Assignment {
  id        String   @id @default(cuid())
  courseId  String
  moduleId  String?
  title     String
  docLink   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@unique([courseId, order])
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  link         String
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
}

// ─── Instructors & Reviews ───────────────────────────────────────────────────

model Instructor {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String
  avatar      String?
  badge       String?
  statLabel   String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  isFounder   Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String
  avatar      String?
  quote       String
  rating      Int      @default(5)
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Enrollment ──────────────────────────────────────────────────────────────

model Enrollment {
  id                   String           @id @default(cuid())
  userId               String
  courseId             String
  status               EnrollmentStatus @default(PENDING)
  paymentMethod        PaymentMethod
  transactionId        String?
  offlinePaymentMethod String?
  offlineReference     String?
  amountPaid           Int?
  // Final price at enrollment time (course price minus coupon discount)
  payableAmount        Int?
  couponId             String?
  couponCode           String?
  discountPercent      Int?
  enrolledAt           DateTime         @default(now())
  approvedAt           DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  description     String?
  expiresAt       DateTime?
  maxUses         Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollments Enrollment[]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
  STUDENT_SUPPORT
  INSTRUCTOR
}

enum CourseStatus {
  UPCOMING
  RUNNING
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentMethod {
  ONLINE
  OFFLINE
}
